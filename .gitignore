# QueueFlow Root Git Ignore

# Dependencies
node_modules/
backend/venv/
backend/.venv/
venv/
.venv/

# Environment Variables & Secrets
.env
.env.*
!.env.example
!.env.*.example

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Next.js build artifacts
frontend/.next/
frontend/out/
frontend/build/
.next/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db


# Additional Python cache
.mypy_cache/
.ruff_cache/


# Local database mock shims (not required in GitHub)
mongomock/
pymongo/

# Old Next.js build artifacts
.next_old/
**/.next_old/

# Next.js generated build/cache folders
.next_build/
**/.next_build/

