# Application Configuration
APP_NAME=QueueFlow API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Configuration
# Replace with your local MongoDB URI or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=queueflow_db
MONGODB_TIMEOUT_MS=3000

# Authentication & Security (JWT)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

